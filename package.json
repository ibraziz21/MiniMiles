{
  "name": "minimiles",
  "version": "1.0.0",
  "description": "Custom Celo Composer project.",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "minimiles",
  "license": "MIT",
  "scripts": {
    "react-app:dev": "yarn workspace @celo-composer-minipay-template/react-app dev",
    "react-app:build": "yarn workspace @celo-composer-minipay-template/react-app build",
    "react-app:start": "yarn workspace @celo-composer-minipay-template/react-app start",
    "react-app:lint": "yarn workspace @celo-composer-minipay-template/react-app lint",
    "admin:dev": "pnpm --filter @minimiles/admin-dashboard dev",
    "admin:build": "pnpm --filter @minimiles/admin-dashboard build",
    "admin:start": "pnpm --filter @minimiles/admin-dashboard start",
    "akiba-app:start": "pnpm --filter @akiba/akiba-app start",
    "akiba-app:ios": "pnpm --filter @akiba/akiba-app ios",
    "akiba-app:android": "pnpm --filter @akiba/akiba-app android",
    "hub:dev": "pnpm --filter @akibamiles/hub-page dev",
    "hub:build": "pnpm --filter @akibamiles/hub-page build",
    "hub:start": "pnpm --filter @akibamiles/hub-page start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celo-org/celo-composer.git"
  },
  "bugs": {
    "url": "https://github.com/celo-org/celo-composer/issues"
  },
  "homepage": "https://github.com/celo-org/celo-composer/blob/main/README.md",
  "workspaces": [
    "packages/*",
    "hardhat/*"
  ],
  "keywords": [
    "celo-composer",
    "celo"
  ],
  "dependencies": {
    "posthog-js": "^1.302.2",
    "truncate-eth-address": "^1.0.2"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7"
  },
  "pnpm": {
    "hoistPattern": [
      "*",
      "!@types/react",
      "!@types/react-dom"
    ]
  }
}
