# Supabase — server-only (NEVER expose to browser)
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""

# iron-session secret — min 32 chars random string
SESSION_SECRET=""

# Local/test only. Set false to require login during local development.
ADMIN_OPEN_ACCESS="true"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin invite secret — used to bootstrap the first super_admin account
ADMIN_BOOTSTRAP_SECRET=""

# ── Payout configuration ──────────────────────────────────────────────────────
# AES-256-GCM key for encrypting merchant payout destination details (32 bytes).
# Generate with: openssl rand -hex 32
# SAME KEY must be set in merchant-dashboard. NEVER commit a real key.
PAYOUT_ENCRYPTION_KEY=""

# Bearer token for the automated reconciliation cron job.
# Generate with: openssl rand -hex 32
# Usage: Authorization: Bearer <RECONCILIATION_CRON_SECRET>
RECONCILIATION_CRON_SECRET=""

# Bearer token for the daily order-lifecycle reconciliation digest cron
# (POST /api/admin/reconciliation/digest — counts the 4 reconciliation
# queues and logs a snapshot). Separate from RECONCILIATION_CRON_SECRET
# above, which is scoped to payout reconciliation only.
# Generate with: openssl rand -hex 32
RECONCILIATION_DIGEST_CRON_SECRET=""

# Vercel Cron auth. Vercel always invokes vercel.json cron paths with GET and
# auto-injects "Authorization: Bearer <this value>" when this exact env var
# name is set — that's how the reconciliation digest's GET handler is
# actually reached in production (RECONCILIATION_DIGEST_CRON_SECRET above is
# for the POST path only; Vercel Cron can't set a custom Bearer value, so it
# can't use that one). Vercel sets this automatically for projects with Cron
# Jobs enabled; only set it yourself for local/non-Vercel testing.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
