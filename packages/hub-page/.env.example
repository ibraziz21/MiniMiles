# Akiba Hub (packages/hub-page) — tracked environment contract.
# production-readiness-security-spec.md §10.1. Placeholders only — never
# commit real credentials here. Validated at server startup by
# src/lib/env.server.ts; production fails closed on missing/malformed
# required values (see that file for the exact rules).
#
# `.env.local.example` (gitignored) has richer prose/spec cross-references
# for local onboarding; this file is the canonical, CI-checkable inventory.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# Service role — server-side only, never exposed to the browser. Required.
SUPABASE_SERVICE_KEY=<service-role-secret>

# ── Public origins ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hub.akibamiles.com
# Optional. Used to build quest CTA links into the React app.
NEXT_PUBLIC_REACT_APP_URL=

# ── Analytics ────────────────────────────────────────────────────────────────
# Optional. GA4 Measurement ID. Unset disables Google Analytics entirely
# (no script loaded) — see src/app/layout.tsx.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Celo (on-chain balance reads, claw voucher issuance) ───────────────────
CELO_RPC_URL=https://forno.celo.org
MINIPOINTS_ADDRESS=0x0000000000000000000000000000000000000000

# ── Akiba Platform (Miles spend and referral reward delivery) ──────────────
# AKIBA_API_URL and AKIBA_API_KEY are required in production. Referral jobs
# remain safely queued without them, but no Miles can be released.
AKIBA_API_URL=
AKIBA_API_KEY=
AKIBA_PARTNER_SLUG=
AKIBA_PARTNER_KEY_ID=
AKIBA_WEBHOOK_SECRET=
AKIBA_QUEST_MAP=

# ── Hub Pass / internal workers ─────────────────────────────────────────────
# Required in production. Must be its own 32+ char random secret — never
# falls back to SUPABASE_SERVICE_KEY. Generate with: openssl rand -base64 48
HUB_PASS_SECRET=
# Required in production. Dedicated signer for opaque referral attribution
# cookies; it must not equal HUB_PASS_SECRET or SUPABASE_SERVICE_KEY.
HUB_REFERRAL_SECRET=
# Shared secret checked via x-webhook-secret on internal worker POST routes.
# Required in production.
INTERNAL_WEBHOOK_SECRET=
# Vercel Cron auth for GET-invoked worker routes; set automatically by
# Vercel when Cron Jobs are enabled. Only set manually for local/non-Vercel
# testing.
CRON_SECRET=
# Shared secret for POST /api/internal/revalidate-merchant-directory.
DIRECTORY_REVALIDATION_SECRET=

# ── M-Pesa (Daraja) ──────────────────────────────────────────────────────────
# Must be exactly "sandbox" or "production".
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must resolve to the same host as NEXT_PUBLIC_SITE_URL in production.
MPESA_CALLBACK_URL=https://hub.akibamiles.com/api/payments/mpesa/callback
# Required in production once M-Pesa credentials above are set.
MPESA_CALLBACK_SECRET=
# USD -> KES exchange rate used for checkout pricing.
USD_TO_KES=130

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# All three required together, or all left unset. Generate with:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@akibamiles.com

# ── Hub quest catalog staged rollout ────────────────────────────────────────
HUB_QUESTS_ENABLED=false
HUB_QUESTS_ROLLOUT_PERCENT=0
HUB_QUESTS_ALLOWLIST=

# ── Launch-flow feature flags (production-readiness-security-spec.md §13) ──
# Each flow is also gated on its own required config being present; these
# toggles are the fast kill switch on top of that. All default to enabled
# except wallet linking, which stays off until Workstream A ships.
WALLET_LINKING_ENABLED=false
MPESA_INITIATION_ENABLED=true
OFFLINE_PASS_ENABLED=true
HUB_QUEST_CLAIMS_ENABLED=true
CLAW_VOUCHER_ISSUANCE_ENABLED=true
