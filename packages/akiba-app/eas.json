{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "node": "22.13.0",
      "env": { "AKIBA_BUILD_VARIANT": "development" },
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "node": "22.13.0",
      "env": { "AKIBA_BUILD_VARIANT": "preview" },
      "android": { "buildType": "apk" }
    },
    "screenshots": {
      "distribution": "internal",
      "environment": "preview",
      "node": "22.13.0",
      "env": {
        "AKIBA_BUILD_VARIANT": "preview",
        "EXPO_PUBLIC_SCREENSHOT_MODE": "true"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "node": "22.13.0",
      "env": { "AKIBA_BUILD_VARIANT": "production" },
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6826160217",
        "appleTeamId": "6DQJX4ZG84"
      },
      "android": { "track": "internal" }
    }
  }
}
