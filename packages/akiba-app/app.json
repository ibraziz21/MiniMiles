{
  "expo": {
    "name": "Akiba Pass",
    "slug": "akiba-pass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "akibapass",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.akiba.pass",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.akiba.pass",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FCFCFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Akiba Pass to use your location to show nearby merchants."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "configurationNotes": {
        "bundleIdentifiersArePlaceholders": true,
        "replacementPhase": "Phase 0 store registration"
      }
    }
  }
}
