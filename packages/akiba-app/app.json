{
  "expo": {
    "name": "Akiba Pass",
    "slug": "akiba-pass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "akibapass",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.akiba.pass",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.akiba.pass",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FCFCFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Akiba Pass to use your location to show nearby merchants."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "configurationNotes": {
        "bundleIdentifiersArePlaceholders": true,
        "blockedOn": "AKIBA-MOB-002 \u00a720 \u2014 final iOS bundle id and Android package name",
        "easProjectIdPending": "Set expo.owner and extra.eas.projectId once the organization account exists"
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "enabled": false
    }
  }
}
