{
  "expo": {
    "name": "Akiba",
    "slug": "akiba",
    "owner": "akiba-holdings-llc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "akiba",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.akibamiles.akiba",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.akibamiles.akiba",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#238D9D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Akiba to use your location to show nearby merchants."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b0a8fd39-ca2d-4ec7-91f9-30537b945ef0"
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "enabled": false
    }
  }
}
