{
  "expo": {
    "name": "Akiba",
    "slug": "akiba",
    "owner": "akiba-holdings-llc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "akiba",
    "userInterfaceStyle": "light",
    "ios": {
      "appleTeamId": "6DQJX4ZG84",
      "bundleIdentifier": "com.akibamiles.akiba",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:pass.akibamiles.com",
        "applinks:pass.akibamiles.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.akibamiles.akiba",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#238D9D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "pass.akibamiles.com",
              "pathPrefix": "/merchants"
            },
            {
              "scheme": "https",
              "host": "pass.akibamiles.com",
              "pathPrefix": "/vouchers"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Akiba to use your location to show nearby merchants."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Akiba to choose photos for your verified visits.",
          "cameraPermission": "Allow Akiba to take photos for your verified visits.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#238D9D",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "b0a8fd39-ca2d-4ec7-91f9-30537b945ef0"
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "updates": {
      "enabled": false
    }
  }
}
