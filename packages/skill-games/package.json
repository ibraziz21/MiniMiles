    "tailwind-merge": "^2.5.4"
  },
  "peerDependencies": {
    "next": "^14.2.0 || ^16.0.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0 || ^19.2.14",
    "@types/react-dom": "^18.3.0 || ^19.2.3",
    "typescript": "^5.6.3"
