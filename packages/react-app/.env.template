# How long a "submitted" self-claim intent may sit with no on-chain receipt
# before it's treated as a dropped transaction rather than merely slow to
# mine (docs/daily-checkin-self-claim-spec.md §6, §10).
DAILY_CLAIM_STALE_SUBMITTED_MS="600000"
# How many prior scopes back the voucher engine sweeps for a wallet's own
# dangling intents on its next voucher request (all-quests-self-claim-spec.md §9).
DAILY_CLAIM_SWEEP_LOOKBACK_DAYS="3"
