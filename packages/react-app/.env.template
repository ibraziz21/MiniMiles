# Self-claim for interactive quests (docs/all-quests-self-claim-spec.md).
# Generic policy — controls every family listed in QUEST_SELF_CLAIM_FAMILIES:
#   off | allowlist | on — "off" keeps that family's existing Akiba-paid queue.
QUEST_SELF_CLAIM_MODE="off"
# Comma-separated lowercase wallets, only consulted when mode="allowlist".
QUEST_SELF_CLAIM_ALLOWLIST=""
# Comma-separated family keys opted into the generic policy above, e.g.
# "daily_checkin,daily_transfer,daily_receive,daily_5tx,daily_10tx,daily_20tx,daily_kiln_hold".
# A family absent here keeps its current sponsored behavior unchanged.
QUEST_SELF_CLAIM_FAMILIES="daily_checkin,daily_transfer,daily_receive,daily_5tx,daily_10tx,daily_20tx,daily_kiln_hold"
# Deprecated compatibility fallback for daily_checkin ONLY, used only while
# daily_checkin is absent from QUEST_SELF_CLAIM_FAMILIES above (see
# docs/daily-checkin-self-claim-spec.md). Migrate onto the generic vars above.
DAILY_SELF_CLAIM_MODE="off"
DAILY_SELF_CLAIM_ALLOWLIST=""
# Deployed Celo DailyQuestClaimer — see spec §"Existing Celo deployment".
DAILY_QUEST_CLAIMER_ADDRESS="0xa9e6adb52e74151553c140615a09119d501c75ce"
# Dedicated voucher-signing key — never falls back to PRIVATE_KEY.
QUEST_VOUCHER_SIGNER_KEY=""
CELO_RPC_URL="https://forno.celo.org"
# Hard ceiling on a single claim's self-claim award (spec §11) — the deployed
# contract has no pause switch or on-chain amount cap.
DAILY_CLAIM_MAX_POINTS="500"

# 20-transfers daily quest — previously had no registry entry (fell back to
